{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentlock.local/schemas/fixture-catalog.schema.json",
  "title": "IntentLock fixture catalog",
  "description": "Expected outcomes for deterministic IntentLock verification fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "safeVersion", "decisionEnum", "targetCount", "fixtures"],
  "properties": {
    "catalogVersion": { "type": "string", "const": "1.0.0" },
    "safeVersion": { "type": "string", "const": "1.4.1" },
    "decisionEnum": {
      "type": "array",
      "const": ["ATTEST", "ATTEST_WITH_TIMELOCK", "REFUSE_UNSUPPORTED", "REFUSE_POLICY"]
    },
    "targetCount": { "type": "integer", "minimum": 40 },
    "fixtures": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "critical", "category", "kind", "title", "setup", "action", "decision", "workflowStatus", "attemptedOnchain", "executionSucceeds", "expectedRevert", "assertions"],
      "properties": {
        "id": { "type": "string", "pattern": "^(B|A|D|P|H|F)[0-9]{2}$" },
        "critical": { "type": "boolean" },
        "category": { "type": "string", "enum": ["benign", "deception", "attestation", "replay", "decoder", "policy", "timelock", "integration", "availability"] },
        "kind": { "type": "string", "enum": ["benign", "attack", "unknown", "availability"] },
        "title": { "type": "string", "minLength": 4 },
        "setup": { "type": "string", "minLength": 4 },
        "action": { "type": "string", "minLength": 4 },
        "decision": { "enum": ["ATTEST", "ATTEST_WITH_TIMELOCK", "REFUSE_UNSUPPORTED", "REFUSE_POLICY"] },
        "workflowStatus": { "enum": ["AWAITING_THRESHOLD", "APPROVED", "TIMELOCK_PENDING", "TIMELOCK_READY", "QUARANTINED", "REJECTED", "EXECUTION_FAILED", "EXECUTED", "CANCELLED", "EXPIRED"] },
        "attemptedOnchain": { "type": "boolean" },
        "executionSucceeds": { "type": "boolean" },
        "expectedRevert": {
          "type": ["string", "null"],
          "enum": ["NoAttestation", "WrongSafe", "WrongChain", "WrongNonce", "DigestMismatch", "IntentMismatch", "ThresholdNotMet", "Expired", "AlreadyConsumed", "PolicyDenied", "TimelockNotReady", "TimelockCancelled", "UnsupportedOperation", "TargetCodeHashMismatch", "ImplementationMismatch", "WrongPolicyClass", "RegistryUnavailable", "OnlyGuard", "InvalidSignature", "InvalidVerifierSet", "GS104", null]
        },
        "demoScene": { "type": "string", "minLength": 3 },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } }
      },
      "allOf": [
        {
          "if": { "properties": { "attemptedOnchain": { "const": false } }, "required": ["attemptedOnchain"] },
          "then": { "properties": { "expectedRevert": { "type": "null" } } }
        },
        {
          "if": { "properties": { "expectedRevert": { "type": "string" } }, "required": ["expectedRevert"] },
          "then": { "properties": { "executionSucceeds": { "const": false } } }
        },
        {
          "if": { "properties": { "executionSucceeds": { "const": true } }, "required": ["executionSucceeds"] },
          "then": { "properties": { "expectedRevert": { "type": "null" } } }
        }
      ]
    }
  }
}
