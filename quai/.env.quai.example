# Orchard Cyprus-1 only. Use a fresh, dedicated testnet wallet.
QUAI_RPC_URL=https://orchard.rpc.quai.network
QUAI_CHAIN_ID=15000
QUAI_PRIVATE_KEY=

# Exactly three distinct public verifier addresses. Keep their signing keys local.
QUAI_VERIFIERS=
QUAI_VERIFIER_SET_ID=
QUAI_POLICY_FILE=policy.orchard.json

# Set to YES only after the human review and explicit deployment approval.
ALLOW_ORCHARD_BROADCAST=
