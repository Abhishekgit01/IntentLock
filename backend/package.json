{
  "name": "intentlock-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/config.js && node --check src/proposals.js && node --check src/attestations.js && node --check src/events.js && node --check src/safe.js && node --check src/policy.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"*.json\""
  },
  "dependencies": {
    "fastify": "5.12.8",
    "viem": "2.58.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "prettier": "3.10.1"
  }
}
